{
  "bar": {
    "contentPadding": 4,
    "density": "comfortable",
    "fontScale": 1.1,
    "position": "top",
    "widgetSpacing": 8,
    "widgets": {
      "center": [
        {
          "characterCount": 10,
          "hideUnoccupied": true,
          "id": "Workspace",
          "labelMode": "name",
          "showApplications": true
        }
      ],
      "left": [
        {
          "id": "Launcher"
        },
        {
          "id": "ActiveWindow"
        },
        {
          "id": "Taskbar",
          "showPinnedApps": false,
          "showTitle": true,
          "smartWidth": false,
          "titleWidth": 150
        }
      ],
      "right": [
        {
          "id": "Tray"
        },
        {
          "id": "Network"
        },
        {
          "compactMode": false,
          "id": "SystemMonitor",
          "usePadding": true
        },
        {
          "id": "Battery",
          "showNoctaliaPerformance": true,
          "showPowerProfiles": true
        },
        {
          "id": "Volume"
        },
        {
          "id": "Brightness"
        },
        {
          "formatHorizontal": "HH:mm -- dd MMMM",
          "formatVertical": "HH:mm -- dd MMMM",
          "id": "Clock",
          "tooltipFormat": "HH:mm -- dd MMMM"
        },
        {
          "id": "ControlCenter",
          "useDistroLogo": true
        }
      ]
    }
  },
  "calendar": {
    "cards": [
      {
        "enabled": true,
        "id": "calendar-header-card"
      },
      {
        "enabled": true,
        "id": "calendar-month-card"
      },
      {
        "enabled": false,
        "id": "weather-card"
      }
    ]
  },
  "controlCenter": {
    "cards": [
      {
        "enabled": true,
        "id": "profile-card"
      },
      {
        "enabled": true,
        "id": "shortcuts-card"
      },
      {
        "enabled": true,
        "id": "audio-card"
      },
      {
        "enabled": false,
        "id": "brightness-card"
      },
      {
        "enabled": false,
        "id": "weather-card"
      },
      {
        "enabled": true,
        "id": "media-sysmon-card"
      }
    ]
  },
  "location": {
    "autoLocate": false,
    "showCalendarWeather": false,
    "name": "Berlin, Germany",
    "use12hourFormat": false,
    "weatherEnabled": false,
    "weatherShowEffects": false
  }
}
